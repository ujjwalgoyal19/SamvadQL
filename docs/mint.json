{
  "$schema": "https://mintlify.com/schema.json",
  "name": "SamvadQL",
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "favicon": "/favicon.svg",
  "colors": {
    "primary": "#2e8555",
    "light": "#33925d",
    "dark": "#205d3b",
    "anchors": {
      "from": "#2e8555",
      "to": "#4caf50"
    }
  },
  "topbarLinks": [
    {
      "name": "Support",
      "url": "mailto:support@samvadql.com"
    }
  ],
  "topbarCtaButton": {
