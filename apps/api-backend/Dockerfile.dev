# Development-optimized Dockerfile for fast iteration
# This Dockerfile prioritizes build speed over image size
# Volume mounts provide live code updates, so we don't copy application code

FROM python:lts

WORKDIR /app

# System dependencies (cached layer)
# Using full python:lts (not slim) to avoid reinstalling build tools
RUN apt-get update && apt-get install -y \
  build-essential \
  gcc \
  g++ \
  curl \
  && rm -rf /var/lib/apt/lists/*

# Upgrade pip first
RUN pip install --no-cache-dir --upgrade pip

# Copy and install core dependencies first (changes more frequently)
COPY requirements-core.txt .
RUN pip install --no-cache-dir -r requirements-core.txt

# Copy and install ML dependencies (changes rarely, cached longer)
COPY requirements-ml.txt .
RUN pip install --no-cache-dir -r requirements-ml.txt

# Dev dependencies last
COPY requirements-dev.txt .
RUN pip install --no-cache-dir -r requirements-dev.txt

# Expose API and debugger ports
EXPOSE 8000 5679

# Development server with hot-reload enabled
# Application code is mounted via volume, not copied
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
