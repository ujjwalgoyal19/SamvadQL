    {
      "name": "API Reference",
      "url": "api-reference"
    },
    {
      "name": "Components",
      "url": "components"
    }
  ],
  "anchors": [
    {
      "name": "Documentation",
      "icon": "book-open-cover",
      "url": "https://docs.samvadql.com"
    },
    {
      "name": "Community",
      "icon": "slack",
      "url": "https://samvadql.slack.com"
    },
    {
      "name": "Blog",
      "icon": "newspaper",
      "url": "https://blog.samvadql.com"
    }
  ],
  "navigation": [
    {
      "group": "Get Started",
