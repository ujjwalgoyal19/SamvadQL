      "pages": [
        "components/hooks/use-query",
        "components/hooks/use-websocket",
        "components/hooks/use-schema"
      ]
    },
    {
      "group": "Services",
      "pages": [
        "components/services/api-client",
        "components/services/websocket-client"
      ]
    }
