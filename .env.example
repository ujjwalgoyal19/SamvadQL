# SamvadQL Development Environment Configuration

# Database Configuration (Local development)
DATABASE_URL=postgresql://samvadql:password@localhost:5432/samvadql

# Redis Configuration (Local development)
REDIS_URL=redis://localhost:6379

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# Pinecone Vector Database Configuration
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=samvadql-vectors

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# API Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Development Mode
DEV_MODE=true

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Compose project name (affects image naming)
COMPOSE_PROJECT_NAME=samvadql

# Frontend HMR (Hot Module Replacement)
VITE_HMR_PORT=24678
