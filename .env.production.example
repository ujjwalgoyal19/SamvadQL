# SamvadQL Production Environment Configuration
# Copy this file to .env.production and fill in your production values
# WARNING: Never commit the actual .env.production file to version control

# ============================================================================
# DATABASE CONFIGURATION (Production)
# ============================================================================
# Use a managed PostgreSQL service for production (AWS RDS, Azure Database, etc.)
# or a reliable PostgreSQL instance with backups enabled
DATABASE_URL=postgresql://user:password@your-db-host:5432/samvadql_prod

# ============================================================================
# REDIS CONFIGURATION (Production)
# ============================================================================
# Use a managed Redis service for production (AWS ElastiCache, Azure Cache, etc.)
# or a Redis instance with replication and persistence enabled
REDIS_URL=redis://default:password@your-redis-host:6379/0

# ============================================================================
# SECURITY
# ============================================================================
# Generate a strong secret key for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-production-secret-key-change-this-NOW

# JWT algorithm for token signing
ALGORITHM=HS256

# ============================================================================
# LLM SERVICES CONFIGURATION
# ============================================================================

# Primary LLM Provider (openai, anthropic, ollama, deepseek)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-production-openai-key-here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# (Optional) Anthropic Configuration (if using Anthropic as fallback)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ============================================================================
# PINECONE VECTOR DATABASE CONFIGURATION
# ============================================================================
# Pinecone provides semantic search for intelligent schema selection

# API Key for Pinecone (get from https://www.pinecone.io)
PINECONE_API_KEY=your-pinecone-production-api-key

# Index name in your Pinecone project (e.g., "samvadql-prod")
# Note: This index should be created in your Pinecone project before deploying
PINECONE_INDEX_NAME=samvadql-prod

# For newer Pinecone API (v1.0+), use one of:
# Option 1: Pinecone serverless (recommended for new projects)
# PINECONE_SERVERLESS_REGION=aws-us-east-1  # e.g., gcp-starter, aws-us-west-2

# Option 2: Pinecone pod-based (older API)
PINECONE_ENVIRONMENT=us-east-1-aws

# Optional: Pinecone namespace for multi-tenancy
# Leave empty for default namespace, or specify a tenant-specific namespace
PINECONE_NAMESPACE=

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Allowed origins for CORS (comma-separated)
# Production: Add your actual domain
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# Backend CORS origins (for FastAPI)
BACKEND_CORS_ORIGINS=["https://yourdomain.com"]

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================

# Disable debug mode in production (security critical)
DEBUG=false

# Development mode must be false in production
DEV_MODE=false

# Log level for production (INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# DEPLOYMENT & INFRASTRUCTURE
# ============================================================================

# Compose project name (affects image/container naming)
COMPOSE_PROJECT_NAME=samvadql-prod

# Number of Uvicorn workers (adjust based on CPU cores and memory)
# Recommendation: (number_of_cores * 2) + 1
UVICORN_WORKERS=5

# Worker timeout in seconds
UVICORN_TIMEOUT=120

# ============================================================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================================================

# Database connection pool size (adjust based on load)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis key prefix (useful for multiple environments using same Redis instance)
REDIS_KEY_PREFIX=samvadql_prod:

# Logging
# SENTRY_DSN=your-sentry-dsn-for-error-tracking
# LOG_FORMAT=json

# Feature flags (for staged rollouts)
# ENABLE_EXPERIMENTAL_FEATURES=false

# Rate limiting
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Query execution timeout (seconds)
QUERY_TIMEOUT=30

# Cache TTL (seconds)
CACHE_TTL=3600

# ============================================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ============================================================================
# 
# 1. NEVER commit the actual .env.production file to version control
#    Use this .env.production.example as a template for your CI/CD
#
# 2. Use your deployment platform's secrets management:
#    - GitHub Actions: GitHub Secrets
#    - AWS: AWS Secrets Manager or Parameter Store
#    - Azure: Azure Key Vault
#    - Docker: Docker secrets or use compose.prod.yml with environment override
#
# 3. Before deploying to production, verify:
#    ✓ DATABASE_URL points to a production PostgreSQL instance with backups
#    ✓ REDIS_URL points to a production Redis instance with persistence
#    ✓ PINECONE_API_KEY and PINECONE_INDEX_NAME are set correctly
#    ✓ OPENAI_API_KEY is valid and has sufficient quota
#    ✓ SECRET_KEY is strong and unique (use openssl rand -hex 32)
#    ✓ ALLOWED_ORIGINS matches your actual domain
#    ✓ DEBUG=false and DEV_MODE=false
#    ✓ All required LLM credentials are set
#
# 4. Recommended security practices:
#    - Use HTTPS only (redirect HTTP to HTTPS)
#    - Enable CORS only for your frontend domain
#    - Rotate SECRET_KEY periodically
#    - Use strong database passwords
#    - Enable SSL/TLS for database connections
#    - Monitor logs and set up alerts
#    - Use managed services (RDS, ElastiCache) for data persistence
#
# 5. Performance tuning:
#    - Adjust UVICORN_WORKERS based on CPU cores and expected load
#    - Use a reverse proxy (nginx, HAProxy) in front of the backend
#    - Enable caching with appropriate TTL values
#    - Monitor database connection pool utilization
#    - Use a CDN for static assets
#
# 6. Monitoring and observability:
#    - Configure logging (use LOG_LEVEL=INFO for production)
#    - Set up error tracking (Sentry, DataDog, etc.)
#    - Monitor database performance
#    - Track API response times
#    - Monitor vector database (Pinecone) usage
#
# ============================================================================
