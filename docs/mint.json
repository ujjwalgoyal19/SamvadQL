      "pages": [
        "features/text-to-sql",
        "features/streaming",
        "features/schema-selection",
        "features/multi-database",
        "features/validation"
      ]
    },
    {
      "group": "Development",
      "pages": [
        "development/setup",
        "development/backend-dev",
        "development/frontend-dev",
        "development/testing",
        "development/deployment"
      ]
    },
    {
      "group": "API Documentation",
      "pages": [
        "api-reference/introduction",
        "api-reference/authentication",
        "api-reference/errors"
      ]
    },
    {
      "group": "Query Endpoints",
      "pages": [
        "api-reference/query/generate",
        "api-reference/query/execute",
        "api-reference/query/history"
      ]
    },
    {
      "group": "Schema Endpoints",
      "pages": [
        "api-reference/schema/get-schema",
        "api-reference/schema/search",
        "api-reference/schema/table-info"
      ]
    },
    {
      "group": "WebSocket",
      "pages": [
